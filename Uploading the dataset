# Neural Network

def train_neural_network(X_train, y_train, hidden_layer_sizes=(100,), learning_rate_init=0.001, max_iter=1000):
    
    # Start measuring energy consumption
    meter = pyRAPL.Measurement("NeuralNetwork")
    meter.begin()
    start_time = time.time()
    model = MLPClassifier(hidden_layer_sizes=hidden_layer_sizes, learning_rate_init=learning_rate_init,
