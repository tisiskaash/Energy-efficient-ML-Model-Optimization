Define Pymoo optimization for Logistic Regression
class LogisticRegressionProblem(ElementwiseProblem):

    def __init__(self, X_train, y_train, X_test, y_test):

        # Store training and testing data
        self.X_train = X_train
        self.y_train = y_train
        self.X_test = X_test
        self.y_test = y_test

        # Define hyperparameter range and optimization objectives
        super().__init__(n_var=3, n_obj=2, xl=[0.001, 0, 0], xu=[100, 1, 1])

    # Evaluate each solution during optimization
    def _evaluate(self, x, out, *args, **kwargs):
        
        # Get current C value
        C = float(x[0])

        # Convert numerical values to solver and penalty
        solver = LR_SOLVERS[int(round(x[1]))]
