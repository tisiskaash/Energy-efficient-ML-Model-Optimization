# Optimize Logistic Regression hyperparameters
def optimize_logistic_regression(X_train, y_train, X_test, y_test):

    # Create optimization problem
    problem = LogisticRegressionProblem(X_train, y_train, X_test, y_test)
    # Configure NSGA-II algorithm
    algorithm = NSGA2(pop_size=20)
    # Run optimization
    result = minimize(problem, algorithm,("n_gen", 50),seed=42,verbose=False)
    # Extract Pareto solutions
    pareto_solutions = result.X
    pareto_objectives = result.F
    print("\nLogistic Regression Pareto Solutions:")
    for i in range(len(pareto_solutions)):
        C = float(pareto_solutions[i][0])
        solver = LR_SOLVERS[int(round(pareto_solutions[i][1]))]
        penalty = LR_PENALTIES[int(round(pareto_solutions[i][2]))]
        accuracy = -pareto_objectives[i][0]
        energy = pareto_objectives[i][1]
        print("C:", C,"| Solver:", solver,"| Penalty:", penalty, "| Accuracy:", accuracy, "| Energy:", energy)

    # Select balanced accuracy-energy solution
    accuracy_scores = -pareto_objectives[:, 0]
    # Normalise accuracy values
    acc_range = accuracy_scores.max() - accuracy_scores.min()
    if acc_range == 0:
        normalised_accuracy = np.ones_like(accuracy_scores)
    else:
        normalised_accuracy = (accuracy_scores - accuracy_scores.min()) / acc_range

    # Normalise energy values
    energy_range = (pareto_objectives[:, 1].max() - pareto_objectives[:, 1].min())
    if energy_range == 0:
        normalised_energy = np.zeros_like(pareto_objectives[:, 1])
    else:
        normalised_energy = (pareto_objectives[:, 1] - pareto_objectives[:, 1].min()) / energy_range

    # Calculate balance score
    score = normalised_accuracy - normalised_energy
    # Select best solution
    best_index = np.argmax(score)
    # Get best hyperparameters
    best_C = float(pareto_solutions[best_index][0])
    best_solver = LR_SOLVERS[int(round(pareto_solutions[best_index][1]))]
    best_penalty = LR_PENALTIES[int(round(pareto_solutions[best_index][2]))]
    print("\nBest Logistic Regression Parameters:")
    print("C:", best_C)
    print("Solver:", best_solver)
    print("Penalty:", best_penalty)

    # Train final optimized model
    model, training_time, energy = train_logistic_regression(X_train, y_train, C=best_C, solver=best_solver, penalty=best_penalty)
    # Evaluate final model
    accuracy = evaluate_model(model, X_test, y_test)

    return (model, accuracy, training_time, energy, best_C, best_solver, best_penalty)

